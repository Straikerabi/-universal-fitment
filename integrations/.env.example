# Server environment only. Never put these values in site/ or the browser.
# Private pilot permission is managed in fitment_private.marketplace_pilots by an admin.
# No user IDs or secrets in the frontend. An empty table denies all searches.
# Optional publishable Auth API key override; Edge runtime supplies keys by default.
MARKETPLACE_SUPABASE_PUBLISHABLE_KEY=
# Keep false until actual provider access and authenticated client integration are verified.
MARKETPLACE_LIVE_ENABLED=false
EBAY_BUY_APPROVED=false
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
AMAZON_CREATORS_APPROVED=false
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_CREDENTIAL_VERSION=3.2
AMAZON_PARTNER_TAG=
