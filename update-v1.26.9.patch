+`)}function sn(e=""){return String(e).toUpperCase().replace(/[^A-HJ-NPR-Z0-9]/g,"").slice(0,17)}function Sl(e=""){let t=sn(e);return t.length!==17?{valid:!1,vin:t,reason:"Eine VIN/FIN hat 17 Zeichen."}:/[IOQ]/.test(t)?{valid:!1,vin:t,reason:"VIN enth\xE4lt unzul\xE4ssige Zeichen."}:{valid:!0,vin:t,reason:"Format plausibel. Fahrzeugdaten m\xFCssen noch \xFCber eine lizenzierte Quelle aufgel\xF6st werden."}}function yl(e=""){return String(e).toUpperCase().replace(/[^A-Z0-9]/g,"").slice(0,4)}function Cl(e=""){return String(e).toUpperCase().replace(/[^A-Z0-9]/g,"").slice(0,8)}var Al=de.brands.join(", "),Bl=[["Warum brauche ich bei Bosch die vollst\xE4ndige E-Nr.?","Die Modellreferenz kann mehrere Ger\xE4teindizes haben. Lies die E-Nr. einschlie\xDFlich der zwei Ziffern nach / vom Typenschild ab und pr\xFCfe das Teil mit dieser Kennung bei Bosch. Die App erfindet keinen Index und verwendet FD oder Seriennummer nicht als Ersatz f\xFCr die E-Nr."],["Sind Bosch-Zubeh\xF6rteile schon als passend best\xE4tigt?","Die App zeigt Artikel aus den jeweiligen Bosch-Modelllisten. Der konkrete /xx-Ger\xE4teindex bleibt offen. Vor Bestellung die Eignung auf der Herstellerseite pr\xFCfen. Bis dahin kann die externe Suche als Teilenotiz mit offenem Preis vorgemerkt werden."],["Warum muss ich den Typenschildtext pr\xFCfen?","OCR kann Zeichen verlesen. Die Vorschau trennt Ger\xE4te- und Teilekennungen, zeigt Widerspr\xFCche und l\xE4sst Korrekturen zu. Ein gemeinsamer Ger\xE4tetyp oder eine Modellfamilie best\xE4tigt keine konkrete Variante. Seriennummern werden nicht zur Suche verwendet."],["Was bedeutet ein Treffer in der Suche?","Die Anzeige nennt die \xFCbereinstimmende Kennung oder zeigt einen \xE4hnlichen Suchtreffer. Sie ist keine berechnete Wahrscheinlichkeit f\xFCr Teile-Passform. Vergleiche Ger\xE4t, Variante und die Teilequelle vor der Bestellung."],["Was ist Universal Fitment?",`Der Staubsaugerkatalog unterst\xFCtzt ${Al}. Die App verkn\xFCpft Modelle mit Beuteln, Filtern, Ersatzteilen, Zubeh\xF6r, Anleitungen und Reparaturvorbereitung. Die jeweilige Herstellerkennung und die verlinkte Quelle bestimmen den Pr\xFCfweg; eine Modellbezeichnung allein best\xE4tigt keine konkrete Teilepassung.`],["Z\xE4hlen verschiedene Farben als eigene Modelle?","Das Modellziel z\xE4hlt verschiedene Modellbezeichnungen. Farb- und Produktionsvarianten werden bei Bedarf als getrennte Ger\xE4teausf\xFChrungen gef\xFChrt; Zubeh\xF6r, Verkaufssets und Familienhinweise f\xFCllen keine zus\xE4tzlichen Modellpl\xE4tze. Die Ziel\xFCbersicht zeigt Modellnamen und offene Teilezuordnungen getrennt."],["Wie aktuell sind die Herstellerdaten und Preise?","Jede Quelle und jeder erfasste Preis nennt seinen eigenen Stand. Preise, Bestand und Lieferzeit sind gespeicherte Quellenst\xE4nde; der aktuelle Shoppreis gilt bei Bestellung. \xC4ltere Preisangaben bleiben gekennzeichnet. Die Sortierung nach erfasstem Preis macht daraus kein aktuelles Angebot und \xE4ndert die Warenkorbpr\xFCfung nicht."],["Wie nutze ich die aufklappbaren Teilebereiche?","\xD6ffne unter deinem Staubsauger die passende Kategorie, zum Beispiel D\xFCsen, Beutel oder Filter. Farbe und Symbol bezeichnen bei jeder Marke dieselbe Teileart. Alle \xF6ffnen und Alle schlie\xDFen steuern die gesamte Liste. Suche und Filter \xF6ffnen die Treffer; die Sortierung nach Name, Preis oder Einbauzeit gilt innerhalb jeder Kategorie."],["Warum steht bei manchen Artikeln Preis offen?","F\xFCr diese Artikel fehlt ein belegter Preis. Die App setzt daf\xFCr keinen Nullpreis ein. Bei der Preissortierung stehen fehlende oder nicht vergleichbare Preise am Ende. Auch erfasste Fremdw\xE4hrungs-, Netto- oder Staffelpreise werden nicht als vergleichbare deutsche Bruttopreise behandelt."],["Warum haben manche Modelle noch keine Teile?","Ein erfasstes Modell ist noch keine vollst\xE4ndige Ersatzteilliste. Artikel werden erst zugeordnet, wenn die Herstellerquelle die Beziehung zum Modell oder zur passenden Ausf\xFChrung nennt. Der Katalog zeigt diese L\xFCcken offen; die Ersatzteilsuche beim Hersteller bleibt \xFCber den vollst\xE4ndigen Ger\xE4tecode erreichbar."],["Wie wird der Versand berechnet?","Die Preisliste rechnet f\xFCr eine Verkaufseinheit mit Standardversand nach Deutschland. Im Warenkorb wird der Versand einmal je H\xE4ndlerbestellung berechnet, einschlie\xDFlich der jeweiligen Freigrenze. Unbekannte Versandkosten und Netto- oder Fremdw\xE4hrungspreise bleiben offen."],["Kann ich gebrauchte Teile auf eBay oder Amazon suchen?","Ja. \xD6ffne \u201EGebrauchte Teile\u201C oder die Kaufoptionen beim einzelnen Teil. eBay sucht mit der Teilenummer und dem gew\xE4hlten Neu-/Gebraucht-Filter. Amazon sucht mit der Teilenummer; gebrauchte Kaufoptionen sind gegebenenfalls auf der Produktseite ausw\xE4hlbar. Zustand, Lieferumfang, Altteilnummer und Anschl\xFCsse im Angebot vergleichen."],["Sind eBay und Amazon schon als Live-Angebote angebunden?","Die externen Suchlinks funktionieren sofort. Live-Angebote innerhalb der App ben\xF6tigen noch freigeschaltete Anbieterzug\xE4nge. Deshalb zeigt die Suche keine erfundenen Angebote, Preise, Bewertungen oder Liefertermine. Eine vorgemerkte Suche bleibt eine Teilenotiz mit offenem Preis."],["Wie bestelle ich aus dem Universal-Warenkorb?","W\xE4hle \u201EBeim H\xE4ndler bestellen\u201C. Die n\xE4chste Seite zeigt Artikel- oder Suchlinks, Teilenummern und die gew\xFCnschte Menge je Position. \xD6ffne den jeweiligen Shop, lege dort die gew\xFCnschte Menge in den Warenkorb und bestelle dort. Deine Einkaufsliste kannst du mit Mengen und Links kopieren."],["Werden die Teile automatisch in fremde Warenk\xF6rbe gelegt?","Noch nicht. Daf\xFCr brauchen wir ein ausgew\xE4hltes Angebot und eine unterst\xFCtzte Anbieter-Anbindung. Ein Suchlink best\xE4tigt noch keinen Verk\xE4ufer, Zustand oder Preis. Die aktuelle Weiterleitung \xFCbertr\xE4gt keine Menge und l\xF6st keine Bestellung aus."],["Bezahle ich bei Universal Fitment oder beim H\xE4ndler?","In dieser Version ausschlie\xDFlich beim jeweiligen H\xE4ndler. Universal Fitment ist ein Einkaufsplan und nimmt keine Zahlung an. Mehrere Shops bedeuten separate Bestellungen. Ein eigener oder eingebetteter Checkout ben\xF6tigt sp\xE4ter die passenden Partnerzug\xE4nge, Vertr\xE4ge und Zahlungsprozesse."],["Sind die Einbauzeiten Herstellerangaben?","Die Minutenangaben sind eigene Sch\xE4tzungen der aktiven Arbeitszeit f\xFCr einen passenden Teilewechsel. Ladezeit, Trocknung und Fehlersuche kommen bei Bedarf separat dazu. Bei ungekl\xE4rter Ausf\xFChrung oder internem Reparaturaufwand bleibt die Einbauzeit offen."],["Muss ich ein Konto erstellen?","Nein. Katalog, Ger\xE4te und Warenkorb funktionieren im Gastmodus. Lokale Sicherungen kannst du als Datei herunterladen und wiederherstellen. Die Pilotanmeldung schaltet keine Cloud-Synchronisation oder ger\xE4te\xFCbergreifende Historie frei."],["Was verliere ich im Gastmodus?","Lokale Daten k\xF6nnen bei Browser-/Ger\xE4teverlust verloren gehen. Cloud-Backup, Synchronisation, zentrale Bestellhistorie und sp\xE4tere Auto-Reorder-Funktionen ben\xF6tigen ein Konto."],["Wie sicher ist die Kompatibilit\xE4tsangabe?","Die App trennt Hersteller-, Katalog-, Community- und Wahrscheinlichkeitsnachweise. KI allein darf niemals ein Teil als passend best\xE4tigen."],["Warum kann sich ein Preis \xE4ndern?","Preise und Best\xE4nde stammen von externen H\xE4ndlern. Die App zeigt den Pr\xFCfzeitpunkt und muss veraltete Angebote als solche kennzeichnen. Vor Weiterleitung soll erneut gepr\xFCft werden."],["Warum sind Versandkosten manchmal unbekannt?","Manche H\xE4ndler berechnen Versand erst im Checkout. Dann zeigt Universal Fitment bewusst \u201Ebeim H\xE4ndler berechnet\u201C statt 0 \u20AC."],["Wer verkauft mir das Teil?","Solange kein eigener Marketplace-Checkout aktiv ist, kommt der Kaufvertrag mit dem jeweiligen H\xE4ndler zustande. Universal Fitment vermittelt bzw. leitet weiter."],["Was passiert mit Typenschild-Fotos?","OCR soll m\xF6glichst lokal im Browser laufen. Fotos werden nicht automatisch dauerhaft gespeichert. Cloud-Speicherung soll nur auf ausdr\xFCcklichen Wunsch erfolgen."],["Was passiert mit meinem Standort?","Standort wird nur auf Anfrage f\xFCr lokale Werkstatt-/Reparaturdienst-Suche verwendet. Eine manuelle Orts-/PLZ-Eingabe bleibt m\xF6glich."],["Bestellt die App automatisch?","Nicht ohne ausdr\xFCckliches Opt-in. Fr\xFChe Versionen bereiten eine Bestellung nur vor und lassen sie vom Nutzer best\xE4tigen."],["Wie melde ich falsche Daten?","Unter Mehr \u2192 Kontakt & Roadmap kannst du einen \xFCberpr\xFCfbaren GitHub-Beitrag vorbereiten und anschlie\xDFend selbst ver\xF6ffentlichen. GitHub-Beitr\xE4ge sind \xF6ffentlich. Die bisherigen Meldefunktionen an Produkt- und Teilseiten merken Hinweise nur lokal vor und senden sie noch nicht an das Team."],["Kann ich per E-Mail Kontakt aufnehmen?","Ein eigenes Supportpostfach wird noch eingerichtet. Das Kontaktformular bereitet aktuell einen GitHub-Entwurf vor oder kopiert den Text. Es versendet keine E-Mail und best\xE4tigt keine Zustellung."],["Wo sehe ich eure weiteren Pl\xE4ne?","Unter Mehr \u2192 Kontakt & Roadmap findest du die Roadmap auf Deutsch und Englisch sowie Patchnotes. Heute liegt der Fokus auf Staubsaugern f\xFCr Deutschland. Weitere Ger\xE4te, Sprachen und internationale M\xE4rkte sind langfristige Ziele. Ideen und Kommentare sind willkommen."],["Welche Marken sind aktiv?",`${Al}. Der Umfang unterscheidet sich je Marke. Samsung und Hoover werden noch ausgebaut; weitere Modelle haben teilweise offene Teilelisten. Eine aktive Marke best\xE4tigt keine vollst\xE4ndige Ger\xE4teausf\xFChrung, keine pauschale Teilepassung und keine Live-Angebote.`],["Wie funktioniert der Reparaturdienst-Finder?","Die App nutzt \u2013 nach Freigabe \u2013 Standort oder manuelle Ortsangabe und \xF6ffnet eine passende lokale Suche. Direkte Partneranfragen folgen sp\xE4ter."]];var dr="https://github.com/Straikerabi/-universal-fitment";var cr=Object.freeze({issue